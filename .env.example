# Copia este archivo a .env y cambia los valores. No subas .env al repositorio.

# MySQL (contenedor)
MYSQL_ROOT_PASSWORD=cambia_esta_password_root
MYSQL_DATABASE=ciencia_datos
MYSQL_USER=ds_user
MYSQL_PASSWORD=cambia_esta_password

# MySQL (conexión desde Python)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# MongoDB (contenedor)
MONGO_USER=ds_mongo
MONGO_PASSWORD=cambia_esta_password_mongo

# MongoDB (conexión desde Python)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# PostgreSQL (contenedor)
POSTGRES_USER=ds_postgres
POSTGRES_PASSWORD=cambia_esta_password_postgres
POSTGRES_DB=ciencia_datos

# PostgreSQL (conexión desde Python)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


